# Environment configuration for Agentic AI Research Assistant
# Fill these with your API credentials when available

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# LangSmith Observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-agent

# Application Security
SECRET_KEY=super-secret-jwt-key-for-agentic-research-assistant-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite+aiosqlite:///./research_assistant.db
SYNC_DATABASE_URL=sqlite:///./research_assistant.db

# Retrieval Guards & Cutoff
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RELEVANCE_SCORE_CUTOFF=0.35
MAX_SUPERVISOR_STEPS=12
MAX_REPLANS=2
